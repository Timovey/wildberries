NODE_ENV=development
DB_HOST="postgresdb"
DB_PORT="5432"
DB_NAME="wildberries"
DB_USER="postgres"
DB_PSD="change-me"
# Токен API Wildberries (личный кабинет продавца → Настройки → Доступ к API), категория «Тарифы»
AUTH_WB=your-wildberries-api-token
# Ключ сервисного аккаунта Google читается из credentials.json (см. README); эти две переменные не используются
GOOGLE_PRIVATE_KEY=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# ID Google Таблицы из её URL: https://docs.google.com/spreadsheets/d/<ID>/edit
GOOGLE_SHEET_ID=your-google-sheet-id
